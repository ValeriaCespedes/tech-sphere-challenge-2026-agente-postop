# Copia este archivo a .env y completa tu API key.
# Consíguela en https://console.groq.com/

GROQ_API_KEY=tu_api_key_aqui

# Modelo de razonamiento (debe ser uno de los permitidos por la rúbrica).
# Verifica el identificador exacto en https://console.groq.com/docs/models
# antes de tu primera corrida real — los IDs de modelo en Groq cambian con el tiempo.
GROQ_LLM_MODEL=llama-3.1-70b-versatile

# Modelo de transcripción (STT). No está restringido por G3 (solo el LLM de
# razonamiento lo está), pero igual verifica el ID vigente en la consola de Groq.
GROQ_STT_MODEL=whisper-large-v3

# Rutas de datos (ajusta si tu carpeta dataset/ vive en otro lugar)
DATASET_DIR=./dataset
TEXTOS_DIR=./dataset/textos
CHROMA_DB_DIR=./data/chroma
